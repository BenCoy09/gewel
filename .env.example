# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional. Change if your key uses a different model.
GEMINI_MODEL=gemini-2.5-flash
# Optional: most AI requests per day for the whole server.
AI_DAILY_MAX=100
# Optional: Neon connection string. When set, stories survive restarts and free hosting.
DATABASE_URL=

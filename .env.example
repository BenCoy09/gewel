# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional. Model names change; check Google AI Studio if you see "status 404".
GEMINI_MODEL=gemini-3.8-flash
# Optional: most AI requests per day for the whole server.
AI_DAILY_MAX=100
# Optional: Neon connection string. When set, stories survive restarts and free hosting.
DATABASE_URL=
